OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
USE_LLM=false

# 与根目录 .env 二选一即可；聚光等 OpenAI 兼容：LLM_* 与 JUGUANG_* 等价别名
# JUGUANG_API_KEY=
# JUGUANG_BASE_URL=https://example/v1
# LLM_SMALL_MODEL=
# LLM_STRONG_MODEL=

# 规则执行员：默认 need_knowledge 两阶段；设为 recall_secondary 启用「召回+违规律复核」
# RULE_EXECUTOR_PIPELINE=recall_secondary

# 对抗侦探：默认 llm（仅 LLM）；deterministic=规则检测+还原不写 LLM；llm_augment=先规则再给 LLM 参考；
# full=检索规则+案例+知识 + 初判 + 违规律复核（输出违规/不确定/正常并进置信度，且跳过 Phase2 规则修订）
# ADVERSARIAL_PIPELINE=llm
# ADVERSARIAL_PIPELINE=deterministic
# ADVERSARIAL_PIPELINE=full
# ADV_DETECTIVE_CATEGORY=通用
